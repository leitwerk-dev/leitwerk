{
	"name": "@leitwerk-dev/skills",
	"version": "0.4.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "extensions/skills"
	},
	"type": "module",
	"leitwerk": {
		"extension": {
			"source": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"pi": {
			"resources": {
				"skills": [
					"./skills"
				]
			}
		}
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@leitwerk-dev/process-sdk": "0.4.0"
	},
	"devDependencies": {
		"@leitwerk-dev/extension-runtime": "0.4.0",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"skills/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
