{
	"name": "@leitwerk-dev/ticket-creation",
	"version": "0.1.9",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "extensions/ticket-creation"
	},
	"type": "module",
	"leitwerk": {
		"extension": {
			"source": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"discover": false
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./testing": {
			"source": "./src/testing.ts",
			"import": "./dist/testing.js",
			"types": "./dist/testing.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.tsup.json --emitDeclarationOnly"
	},
	"dependencies": {
		"@leitwerk-dev/process-sdk": "0.1.9",
		"@leitwerk-dev/external-writes": "0.1.9",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@leitwerk-dev/test-support": "0.1.9",
		"tsup": "^8.5.1",
		"@types/node": "^26.2.0"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
