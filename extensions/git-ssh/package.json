{
	"name": "@leitwerk-dev/git-ssh",
	"version": "0.1.0",
	"type": "module",
	"leitwerk": {
		"extension": {
			"source": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"discover": false
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@leitwerk-dev/process-sdk": "0.1.0"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"files": [
		"dist/**",
		"src/**",
		"!src/**/*.test.ts"
	]
}
