{
	"name": "@leitwerk-dev/telegram",
	"version": "0.1.6",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "extensions/telegram"
	},
	"type": "module",
	"leitwerk": {
		"extension": {
			"source": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"discover": false
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent --config tsup.config.ts"
	},
	"dependencies": {
		"@leitwerk-dev/domain": "0.1.6",
		"@leitwerk-dev/process-sdk": "0.1.6",
		"@leitwerk-dev/protocol": "0.1.6",
		"@leitwerk-dev/worker-protocol": "0.1.6",
		"beautiful-mermaid": "^1.1.3",
		"grammy": "^1.38.4",
		"markdown-it": "^14.1.1",
		"parse5": "^8.0.0",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@leitwerk-dev/test-support": "0.1.6",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^22.15.30",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
