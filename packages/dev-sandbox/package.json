{
	"name": "@leitwerk-dev/dev-sandbox",
	"version": "0.2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/dev-sandbox"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./launcher": {
			"source": "./src/launcher-entry.ts",
			"import": "./dist/launcher-entry.js",
			"types": "./dist/launcher-entry.d.ts"
		},
		"./storage": {
			"source": "./src/storage-entry.ts",
			"import": "./dist/storage-entry.js",
			"types": "./dist/storage-entry.d.ts"
		},
		"./backend": {
			"source": "./src/backend.ts",
			"import": "./dist/backend.js",
			"types": "./dist/backend.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.tsup.json --emitDeclarationOnly"
	},
	"dependencies": {
		"@leitwerk-dev/extension-runtime": "0.2.0",
		"@leitwerk-dev/process-sdk": "0.2.0",
		"@leitwerk-dev/server": "0.2.0",
		"@leitwerk-dev/test-support": "0.2.0",
		"@leitwerk-dev/worker": "0.2.0",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
