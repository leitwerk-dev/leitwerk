{
	"name": "@leitwerk-dev/server",
	"version": "0.3.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/server"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./testing": {
			"source": "./src/testing.ts",
			"import": "./dist/testing.js",
			"types": "./dist/testing.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent",
		"start": "node dist/main.js"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.86.0",
		"@earendil-works/pi-coding-agent": "^0.86.0",
		"@fastify/cookie": "11.1.2",
		"@fastify/websocket": "^11.2.0",
		"@leitwerk-dev/domain": "0.3.1",
		"@leitwerk-dev/extension-runtime": "0.3.1",
		"@leitwerk-dev/external-writes": "0.3.1",
		"@leitwerk-dev/process-sdk": "0.3.1",
		"@leitwerk-dev/protocol": "0.3.1",
		"@leitwerk-dev/session-transfer": "0.3.1",
		"@leitwerk-dev/watcher-utils": "0.3.1",
		"@leitwerk-dev/worker-protocol": "0.3.1",
		"@leitwerk-dev/worker-runners": "0.3.1",
		"cron-parser": "^5.5.0",
		"defu": "^6.1.7",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"esbuild": "0.28.2",
		"fastify": "^5.8.4",
		"openid-client": "6.8.8",
		"sharp": "^0.35.0",
		"valibot": "^1.3.1",
		"yaml": "^2.8.3",
		"@leitwerk-dev/wiki": "0.3.1"
	},
	"optionalDependencies": {
		"@leitwerk-dev/worker": "0.3.1"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"tsx": "^4.21.0"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
