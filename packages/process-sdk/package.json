{
	"name": "@leitwerk-dev/process-sdk",
	"version": "0.2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/process-sdk"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./git-binary": {
			"source": "./src/git-binary.ts",
			"import": "./dist/git-binary.js",
			"types": "./dist/git-binary.d.ts"
		},
		"./leaf-outcome-renderer": {
			"source": "./src/leaf-outcome-renderer.ts",
			"import": "./dist/leaf-outcome-renderer.js",
			"types": "./dist/leaf-outcome-renderer.d.ts"
		},
		"./pi-config": {
			"source": "./src/pi-config-public.ts",
			"import": "./dist/pi-config-public.js",
			"types": "./dist/pi-config-public.d.ts"
		},
		"./review-flow": {
			"source": "./src/review-flow-public.ts",
			"import": "./dist/review-flow-public.js",
			"types": "./dist/review-flow-public.d.ts"
		},
		"./runtime-internals": {
			"source": "./src/runtime-internals-public.ts",
			"import": "./dist/runtime-internals-public.js",
			"types": "./dist/runtime-internals-public.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@leitwerk-dev/domain": "0.2.0",
		"@leitwerk-dev/protocol": "0.2.0",
		"@leitwerk-dev/worker-protocol": "0.2.0",
		"@leitwerk-dev/watcher-utils": "0.2.0",
		"escape-html": "^1.0.3",
		"mustache": "^4.2.0",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@types/escape-html": "^1.0.4",
		"@types/mustache": "^4.2.6",
		"@types/node": "^22.15.30",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
