{
	"name": "@leitwerk-dev/worker",
	"version": "0.1.4",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/worker"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./worker-entry": {
			"source": "./src/worker-entry.ts",
			"import": "./dist/worker-entry.js",
			"types": "./dist/worker-entry.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.81.1",
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@leitwerk-dev/domain": "0.1.4",
		"@leitwerk-dev/extension-runtime": "0.1.4",
		"@leitwerk-dev/process-sdk": "0.1.4",
		"@leitwerk-dev/protocol": "0.1.4",
		"@leitwerk-dev/watcher-utils": "0.1.4",
		"@leitwerk-dev/worker-protocol": "0.1.4",
		"execa": "^9.6.1",
		"fast-glob": "^3.3.3",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.30",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
