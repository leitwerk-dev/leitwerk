{
	"name": "@leitwerk-dev/worker-runners",
	"version": "0.2.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/worker-runners"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./types": {
			"source": "./src/types-public.ts",
			"import": "./dist/types-public.js",
			"types": "./dist/types-public.d.ts"
		},
		"./local": {
			"source": "./src/local-public.ts",
			"import": "./dist/local-public.js",
			"types": "./dist/local-public.d.ts"
		},
		"./docker": {
			"source": "./src/docker-public.ts",
			"import": "./dist/docker-public.js",
			"types": "./dist/docker-public.d.ts"
		},
		"./docker-client": {
			"source": "./src/docker-client-public.ts",
			"import": "./dist/docker-client-public.js",
			"types": "./dist/docker-client-public.d.ts"
		},
		"./kubernetes": {
			"source": "./src/kubernetes-public.ts",
			"import": "./dist/kubernetes-public.js",
			"types": "./dist/kubernetes-public.d.ts"
		},
		"./kubernetes-client": {
			"source": "./src/kubernetes-client-public.ts",
			"import": "./dist/kubernetes-client-public.js",
			"types": "./dist/kubernetes-client-public.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@leitwerk-dev/domain": "0.2.1",
		"@leitwerk-dev/session-transfer": "0.2.1",
		"@leitwerk-dev/watcher-utils": "0.2.1",
		"@leitwerk-dev/worker-protocol": "0.2.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.30",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	]
}
