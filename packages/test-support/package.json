{
	"name": "@leitwerk-dev/test-support",
	"version": "0.1.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/test-support"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./fakes": {
			"source": "./src/fakes/index.ts",
			"import": "./dist/fakes/index.js",
			"types": "./dist/fakes/index.d.ts"
		},
		"./fixtures": {
			"source": "./src/fixtures.ts",
			"import": "./dist/fixtures.js",
			"types": "./dist/fixtures.d.ts"
		},
		"./integration": {
			"source": "./src/integration.ts",
			"import": "./dist/integration.js",
			"types": "./dist/integration.d.ts"
		},
		"./worker-testing": {
			"source": "./src/worker-testing/index.ts",
			"import": "./dist/worker-testing/index.js",
			"types": "./dist/worker-testing/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.tsup.json --emitDeclarationOnly"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@leitwerk-dev/domain": "0.1.1",
		"@leitwerk-dev/extension-runtime": "0.1.1",
		"@leitwerk-dev/process-sdk": "0.1.1",
		"@leitwerk-dev/protocol": "0.1.1",
		"@leitwerk-dev/server": "0.1.1",
		"@leitwerk-dev/worker": "0.1.1",
		"@leitwerk-dev/worker-protocol": "0.1.1"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
