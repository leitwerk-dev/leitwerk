{
	"name": "@leitwerk-dev/pi-session-transfer",
	"version": "0.2.0",
	"description": "Import a Leitwerk process workspace and Pi conversation into local Pi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/pi-session-transfer"
	},
	"type": "module",
	"keywords": [
		"pi-package",
		"leitwerk",
		"session-transfer"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@leitwerk-dev/session-transfer": "0.2.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@earendil-works/pi-tui": "^0.81.1",
		"@types/node": "^25.0.3",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
