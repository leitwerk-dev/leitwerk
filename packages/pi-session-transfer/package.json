{
	"name": "@leitwerk-dev/pi-session-transfer",
	"version": "0.1.9",
	"description": "Import a Leitwerk process workspace and Pi conversation into local Pi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/pi-session-transfer"
	},
	"type": "module",
	"keywords": [
		"pi-package",
		"leitwerk",
		"session-transfer"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"exports": {
		".": "./src/index.ts"
	},
	"dependencies": {
		"@leitwerk-dev/session-transfer": "0.1.9"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@earendil-works/pi-tui": "^0.81.1",
		"@types/node": "^25.0.3"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"src/**",
		"LICENSE",
		"README.md",
		"!src/**/*.test.ts"
	]
}
