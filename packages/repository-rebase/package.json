{
	"name": "@leitwerk-dev/repository-rebase",
	"version": "0.1.9",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/repository-rebase"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./git": {
			"source": "./src/git.ts",
			"import": "./dist/git.js",
			"types": "./dist/git.d.ts"
		},
		"./prompt": {
			"source": "./src/prompt.ts",
			"import": "./dist/prompt.js",
			"types": "./dist/prompt.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.tsup.json --emitDeclarationOnly"
	},
	"dependencies": {
		"@leitwerk-dev/process-sdk": "0.1.9"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"@types/node": "^26.2.0"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
