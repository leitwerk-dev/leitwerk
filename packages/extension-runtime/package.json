{
	"name": "@leitwerk-dev/extension-runtime",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leitwerk-dev/leitwerk.git",
		"directory": "packages/extension-runtime"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./testing": {
			"source": "./src/testing-entry.ts",
			"import": "./dist/testing-entry.js",
			"types": "./dist/testing-entry.d.ts"
		}
	},
	"scripts": {
		"build": "tsup --silent"
	},
	"dependencies": {
		"@leitwerk-dev/domain": "0.1.0",
		"@leitwerk-dev/process-sdk": "0.1.0",
		"jiti": "^2.6.1",
		"pkg-dir": "^8.0.0",
		"read-pkg-up": "^10.1.0",
		"resolve-package-path": "^4.0.3",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.30",
		"tsup": "^8.5.1"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist/**",
		"src/**",
		"!dist/**/*.test.*",
		"!src/**/*.test.ts"
	]
}
