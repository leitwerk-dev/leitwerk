{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tsconfig.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!src/**/*.test.ts",
				"!src/**/*.test.tsx",
				"!src/**/*.spec.ts",
				"!src/**/*.spec.tsx",
				"!tests/**"
			],
			"env": ["LEITWERK_RUNTIME_LANE"],
			"outputs": ["dist/**"]
		},
		"build:ext-ui": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!src/**/*.test.ts",
				"!src/**/*.test.tsx",
				"!src/**/*.spec.ts",
				"!src/**/*.spec.tsx",
				"!tests/**"
			],
			"outputs": ["dist/ui/**"]
		},
		"lint": {
			"outputs": []
		},
		"check:boundaries": {
			"outputs": []
		}
	}
}
