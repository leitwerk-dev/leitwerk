# syntax=docker/dockerfile:1

# Generic leitwerk worker image shared by Docker Compose and Kubernetes.
#
# This is the demo/easy-setup generic runtime profile. Production should use
# specialized, digest-pinned images closer to each repository's CI toolchain.
# Build and runtime stages use the same pinned Node 26 image. This keeps native
# dependencies and repository validation on the supported runtime baseline.

FROM node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS dependencies
WORKDIR /app

# Keep dependency installation independent of frequently changing source files.
# COPY --parents discovers workspaces under the roots declared in package.json.
COPY --parents \
	package.json \
	package-lock.json \
	packages/*/package.json \
	extensions/*/package.json \
	./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci
# npm can omit Rollup's platform-native optional package inside Linux image
# builds. Install the package matching the Debian/gnu image architecture before
# running tsup/Vite builds.
RUN node -e "const {execFileSync}=require('node:child_process'); const arch=process.arch; const pkg=arch==='arm64'?'@rollup/rollup-linux-arm64-gnu':arch==='x64'?'@rollup/rollup-linux-x64-gnu':undefined; if (pkg) { try { require.resolve(pkg); } catch { execFileSync('npm', ['install', '--no-save', pkg], {stdio:'inherit'}); } }"

FROM dependencies AS build
COPY LICENSE ./
COPY packages ./packages
COPY extensions ./extensions
COPY scripts ./scripts
COPY turbo.json tsconfig.json biome.json ./
RUN npm run build
RUN node scripts/prepare-runtime-layout.mjs /runtime-layout

FROM node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS runtime
ARG TARGETARCH
ARG MISE_VERSION=2026.8.14
WORKDIR /app
ENV NODE_ENV=production \
	PI_CODING_AGENT_DIR=/state/pi-agent \
	PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		git openssh-client bash ca-certificates chromium curl python3 make g++ jq \
		tar gzip xz-utils unzip zstd \
	&& case "$TARGETARCH" in \
		amd64) mise_arch=x64; mise_sha=80b49fa2dff282d3346524aec4466bbab536296ed5ba4d8c3b1b451022e94f56 ;; \
		arm64) mise_arch=arm64; mise_sha=81e1c5fa79c3d46cf93aac0ef9a5540bce9856634901a0db8301a656c370eb58 ;; \
		*) echo "unsupported worker architecture: $TARGETARCH" >&2; exit 1 ;; \
	esac \
	&& archive="mise-v${MISE_VERSION}-linux-${mise_arch}.tar.xz" \
	&& curl -fsSLo "/tmp/$archive" "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/$archive" \
	&& echo "$mise_sha  /tmp/$archive" | sha256sum -c - \
	&& tar -xJf "/tmp/$archive" -C /tmp mise/bin/mise \
	&& install -m 0755 /tmp/mise/bin/mise /usr/local/bin/mise \
	&& /usr/local/bin/mise --version \
	&& rm -rf "/tmp/$archive" /tmp/mise \
	&& rm -rf /var/lib/apt/lists/*

# Jib-style runtime layering: dependencies and manifests remain reusable when
# application code changes. Compiled code and migrations are copied last.
COPY --from=build /app/node_modules ./node_modules
# The generic validation worker runs the repository's complete test:full gate,
# including Playwright browser tests. Link Debian Chromium at the revisioned
# Playwright path without downloading and unpacking a second browser archive.
RUN revision="$(node -e "const b=require('./node_modules/playwright-core/browsers.json').browsers.find((item) => item.name === 'chromium-headless-shell'); process.stdout.write(b.revision)")" \
	&& browser_dir="$PLAYWRIGHT_BROWSERS_PATH/chromium_headless_shell-$revision/chrome-headless-shell-linux64" \
	&& mkdir -p "$browser_dir" \
	&& ln -s /usr/bin/chromium "$browser_dir/chrome-headless-shell"
COPY --from=build /runtime-layout/stable ./
COPY --from=build /runtime-layout/app ./

LABEL org.opencontainers.image.title="leitwerk-worker-generic" \
	org.opencontainers.image.description="generic leitwerk worker" \
	leitwerk.dev/worker-api-version="2026-06-23"

VOLUME ["/state"]
WORKDIR /app/packages/worker
CMD ["/usr/local/bin/node", "dist/worker-entry.js"]
