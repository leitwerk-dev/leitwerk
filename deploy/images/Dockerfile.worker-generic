# syntax=docker/dockerfile:1

# Generic leitwerk worker image shared by Docker Compose and Kubernetes.
#
# This is the demo/easy-setup generic runtime profile. Production should use
# specialized, digest-pinned images closer to each repository's CI toolchain.
# The runtime uses Node 26 so workers can validate repositories that require the
# current Node release. Dependencies remain built on the supported Node 22 toolchain;
# worker code does not load the server-only native SQLite dependency.

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS dependencies
WORKDIR /app

# Keep dependency installation independent of frequently changing source files.
# COPY --parents discovers workspaces under the roots declared in package.json.
COPY --parents \
	package.json \
	package-lock.json \
	packages/*/package.json \
	extensions/*/package.json \
	./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci
# npm can omit Rollup's platform-native optional package inside Linux image
# builds. Install the package matching the Debian/gnu image architecture before
# running tsup/Vite builds.
RUN node -e "const {execFileSync}=require('node:child_process'); const arch=process.arch; const pkg=arch==='arm64'?'@rollup/rollup-linux-arm64-gnu':arch==='x64'?'@rollup/rollup-linux-x64-gnu':undefined; if (pkg) { try { require.resolve(pkg); } catch { execFileSync('npm', ['install', '--no-save', pkg], {stdio:'inherit'}); } }"

FROM dependencies AS build
COPY LICENSE ./
COPY packages ./packages
COPY extensions ./extensions
COPY scripts ./scripts
COPY turbo.json tsconfig.json biome.json ./
RUN npm run build
RUN node scripts/prepare-runtime-layout.mjs /runtime-layout

FROM node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS runtime
WORKDIR /app
ENV NODE_ENV=production \
	PI_CODING_AGENT_DIR=/state/pi-agent \
	PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		git openssh-client bash ca-certificates curl python3 make g++ jq \
	&& rm -rf /var/lib/apt/lists/*

# Jib-style runtime layering: dependencies and manifests remain reusable when
# application code changes. Compiled code and migrations are copied last.
COPY --from=build /app/node_modules ./node_modules
# The generic validation worker runs the repository's complete test:full gate,
# including Playwright browser tests.
RUN npx playwright install --with-deps chromium
COPY --from=build /runtime-layout/stable ./
COPY --from=build /runtime-layout/app ./

LABEL org.opencontainers.image.title="leitwerk-worker-generic" \
	org.opencontainers.image.description="generic leitwerk worker" \
	leitwerk.dev/worker-api-version="2026-06-23"

VOLUME ["/state"]
WORKDIR /app/packages/worker
CMD ["node", "dist/worker-entry.js"]
