# syntax=docker/dockerfile:1

# Leitwerk server image shared by Docker Compose and Kubernetes.
#
# Topology details differ by runner, but the container contract is the same: the
# server listens on port 8080, owns durable state, and uses the configured runner
# to create or connect workers.

FROM node:26-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS dependencies
WORKDIR /app

# Keep dependency installation independent of frequently changing source files.
# COPY --parents discovers workspaces under the roots declared in package.json.
COPY --parents \
	package.json \
	package-lock.json \
	packages/*/package.json \
	extensions/*/package.json \
	./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci
# npm can omit Rollup's platform-native optional package inside Linux image
# builds. Install the package matching the Debian/gnu image architecture before
# running tsup/Vite builds.
RUN node -e "const {execFileSync}=require('node:child_process'); const arch=process.arch; const pkg=arch==='arm64'?'@rollup/rollup-linux-arm64-gnu':arch==='x64'?'@rollup/rollup-linux-x64-gnu':undefined; if (pkg) { try { require.resolve(pkg); } catch { execFileSync('npm', ['install', '--no-save', pkg], {stdio:'inherit'}); } }"

FROM dependencies AS build
COPY LICENSE ./
COPY packages ./packages
COPY extensions ./extensions
COPY scripts ./scripts
COPY turbo.json tsconfig.json biome.json ./
RUN npm run build
RUN npm run build:ext-ui

FROM node:26-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
	&& apt-get install -y --no-install-recommends git ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Copy stable dependencies and manifests before frequently changing application code.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build --parents \
	/app/./package.json \
	/app/./LICENSE \
	/app/./packages/*/package.json \
	/app/./extensions/*/package.json \
	/app/./extensions/*/README.md \
	./
COPY --from=build --parents \
	/app/./packages/*/dist \
	/app/./extensions/*/dist \
	/app/./packages/server/migrations \
	./

LABEL org.opencontainers.image.title="leitwerk-server" \
	org.opencontainers.image.description="leitwerk server" \
	leitwerk.dev/server-api-version="2026-06-23"

EXPOSE 8080
ENV LEITWERK_CONFIG_PATH=/etc/leitwerk/leitwerk.yaml
WORKDIR /app/packages/server
CMD ["node", "dist/main.js"]
