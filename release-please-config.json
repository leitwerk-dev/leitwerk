{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"bootstrap-sha": "0d650094f359c0c8686b5ec0928a607d44fcc866",
	"release-type": "node",
	"initial-version": "0.1.0",
	"include-v-in-tag": false,
	"include-component-in-tag": true,
	"tag-separator": "",
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": true,
	"always-link-local": true,
	"always-update": true,
	"signoff": "github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>",
	"separate-pull-requests": false,
	"group-pull-request-title-pattern": "chore(release): release ${branch}",
	"changelog-sections": [
		{ "type": "feat", "section": "Features" },
		{ "type": "fix", "section": "Bug Fixes" },
		{ "type": "perf", "section": "Performance", "hidden": true },
		{ "type": "refactor", "section": "Refactoring", "hidden": true },
		{ "type": "docs", "section": "Documentation", "hidden": true },
		{ "type": "test", "section": "Tests", "hidden": true },
		{ "type": "build", "section": "Build", "hidden": true },
		{ "type": "ci", "section": "Continuous Integration", "hidden": true },
		{ "type": "chore", "section": "Chores", "hidden": true },
		{ "type": "revert", "section": "Reverts", "hidden": true }
	],
	"plugins": [
		{
			"type": "node-workspace",
			"merge": false,
			"updateAllPackages": true,
			"updatePeerDependencies": true
		},
		{
			"type": "linked-versions",
			"groupName": "leitwerk",
			"merge": true,
			"components": [
				"v",
				"@leitwerk-dev/domain",
				"@leitwerk-dev/extension-runtime",
				"@leitwerk-dev/external-writes",
				"@leitwerk-dev/process-sdk",
				"@leitwerk-dev/protocol",
				"@leitwerk-dev/server",
				"@leitwerk-dev/test-support",
				"@leitwerk-dev/ui",
				"@leitwerk-dev/watcher-utils",
				"@leitwerk-dev/worker-protocol",
				"@leitwerk-dev/worker-runners",
				"@leitwerk-dev/worker",
				"@leitwerk-dev/coding",
				"@leitwerk-dev/git-ssh",
				"@leitwerk-dev/local-repo-change",
				"@leitwerk-dev/local-shell",
				"@leitwerk-dev/models",
				"@leitwerk-dev/pi-shell",
				"@leitwerk-dev/process-analysis",
				"@leitwerk-dev/remote-repo-change",
				"@leitwerk-dev/showcase-processes",
				"@leitwerk-dev/telegram"
			]
		}
	],
	"packages": {
		".": {
			"component": "v",
			"package-name": "leitwerk",
			"changelog-path": "CHANGELOG.md",
			"extra-files": [
				{
					"type": "generic",
					"path": "deploy/kubernetes/helm/leitwerk/Chart.yaml"
				},
				{
					"type": "generic",
					"path": "deploy/kubernetes/helm/leitwerk/values.yaml"
				}
			]
		},
		"packages/domain": {
			"component": "@leitwerk-dev/domain",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"packages/extension-runtime": {
			"component": "@leitwerk-dev/extension-runtime",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"packages/external-writes": {
