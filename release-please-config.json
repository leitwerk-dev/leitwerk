		},
		"extensions/process-analysis": {
			"component": "@leitwerk-dev/process-analysis",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"extensions/remote-repo-change": {
			"component": "@leitwerk-dev/remote-repo-change",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"extensions/showcase-processes": {
			"component": "@leitwerk-dev/showcase-processes",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"extensions/telegram": {
