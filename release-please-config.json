		},
		"extensions/coding": {
			"component": "@leitwerk-dev/coding",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"extensions/git-ssh": {
			"component": "@leitwerk-dev/git-ssh",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"extensions/local-repo-change": {
			"component": "@leitwerk-dev/local-repo-change",
			"skip-github-release": true,
			"skip-changelog": true
		},
		"extensions/local-shell": {
			"component": "@leitwerk-dev/local-shell",
			"skip-github-release": true,
